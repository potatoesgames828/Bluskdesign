# ───────── Blusk Design — variáveis de ambiente ─────────
# Copie para .env.local e preencha. NUNCA versionar valores reais.

# URL pública do app (usada em redirects de e-mail e checkout)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor (webhooks de pagamento / admin). Nunca exponha no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Blusk AI — Anthropic Claude API (somente servidor)
ANTHROPIC_API_KEY=
# Opcional: modelo e esforço
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# Blusk Hunter — Google Places API (New) (somente servidor)
GOOGLE_PLACES_API_KEY=

# Pagamentos — Stripe (somente servidor)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=
